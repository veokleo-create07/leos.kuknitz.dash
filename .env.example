# Run `npm run hash-password` and paste its STAFF_SHARED_PASSWORD_HASH output here.
# This server-only value must not use a NEXT_PUBLIC_ prefix.
STAFF_SHARED_PASSWORD_HASH=

# Generate with: openssl rand -base64 48
# Used to sign and verify the HTTP-only staff session cookie.
STAFF_SESSION_SECRET=

# Server-only connection settings for the existing Supabase project.
# Never add the NEXT_PUBLIC_ prefix or use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
